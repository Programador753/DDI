                "{{baseUrl}}"
              ],
              "path": [
                "schools",
                ":schoolId",
                "students"
              ],
              "variable": [
                {
                  "key": "schoolId",
                  "value": "1",
                  "description": "School ID"
                }
              ]
            },
            "description": "Adds a new student to a specific school (1:N relationship).\n\n**Path Parameters**:\n- `schoolId` (Long): The unique identifier of the school\n\n**Request Body**:\n```json\n{\n    \"name\": \"string\",  // Student name\n    \"role\": \"string\"   // Student role\n}\n```\n\n**Response Codes**:\n- `200 OK`: Student added successfully\n- `404 Not Found`: School does not exist"
          },
          "response": []
        }
